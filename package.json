{
  "name": "bigapizzaproject",
  "version": "1.0.0",
  "description": "App for creating biga pizza dough recipes for wood fired pizza enthusiasts.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky install",
    "dev:backend": "cd biga-pizza-backend && npm run dev",
    "dev:frontend": "cd biga-pizza-frontend && npm run dev",
    "dev": "concurrently -n backend,frontend -c green,blue \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daidensacha/BigaPizzaApp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/daidensacha/BigaPizzaApp/issues"
  },
  "homepage": "https://github.com/daidensacha/BigaPizzaApp#readme",
  "devDependencies": {
    "concurrently": "^9.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
